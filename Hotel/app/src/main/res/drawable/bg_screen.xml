<?xml version="1.0" encoding="utf-8"?>
<!-- Soft colour light on a deep navy ground -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/paper" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.05"
                android:centerY="0.02"
                android:endColor="#000A84FF"
                android:gradientRadius="520dp"
                android:startColor="#660A84FF"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="1.0"
                android:centerY="0.38"
                android:endColor="#0064D2FF"
                android:gradientRadius="420dp"
                android:startColor="#3364D2FF"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.1"
                android:centerY="1.0"
                android:endColor="#00FFB340"
                android:gradientRadius="480dp"
                android:startColor="#33FFB340"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
