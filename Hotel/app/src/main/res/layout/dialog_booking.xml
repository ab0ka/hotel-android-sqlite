<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Қонақтың аты-жөні"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editGuest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="мысалы: Ахметов Д."
        android:importantForAutofill="no"
        android:inputType="text|textNoSuggestions"
        android:textColor="@color/black"
        android:textColorHint="@color/text_second" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Тәулік саны"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editNights"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="1-30"
        android:importantForAutofill="no"
        android:inputType="number"
        android:textColor="@color/black"
        android:textColorHint="@color/text_second" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Адам саны"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editPersons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="төсек санынан аспауы керек"
        android:importantForAutofill="no"
        android:inputType="number"
        android:textColor="@color/black"
        android:textColorHint="@color/text_second" />

    <TextView
        android:id="@+id/txtPriceInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/text_second"
        android:textSize="12sp" />
</LinearLayout>
