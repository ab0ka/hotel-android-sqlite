<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="4dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/txtPriceInfo"
            style="@style/Text.Hotel.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Hotel.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Қонақтың аты-жөні">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editGuest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- DatePicker және TimePicker: диалог арқылы таңдалады -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDate"
                style="@style/Widget.Hotel.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1.15"
                android:maxLines="1"
                android:text="Күні"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTime"
                style="@style/Widget.Hotel.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="Уақыты"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- SeekBar: тәулік саны -->
        <TextView
            android:id="@+id/txtNights"
            style="@style/Text.Hotel.Serif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="18sp" />

        <SeekBar
            android:id="@+id/seekNights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="29"
            android:progress="0"
            android:progressTint="@color/accent_2"
            android:thumbTint="@color/ink" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Hotel.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Адам саны">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editPersons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- CheckBox, ToggleButton, RadioButton -->
        <CheckBox
            android:id="@+id/chkBreakfast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:buttonTint="@color/accent_2"
            android:minHeight="48dp"
            android:text="Таңғы ас кіреді"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <ToggleButton
            android:id="@+id/tglTransfer"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_toggle"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textOff="Әуежайдан трансфер: жоқ"
            android:textOn="Әуежайдан трансфер: иә"
            android:textSize="15sp" />

        <RadioGroup
            android:id="@+id/radioPay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioCash"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/accent_2"
                android:checked="true"
                android:minHeight="48dp"
                android:text="Қолма-қол"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/radioCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/accent_2"
                android:minHeight="48dp"
                android:text="Карта"
                android:textColor="@color/ink" />
        </RadioGroup>

        <!-- Живой расчёт: cost = nights x price -->
        <TextView
            android:id="@+id/txtCostPreview"
            style="@style/Text.Hotel.Serif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_stock"
            android:padding="14dp"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
